@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="book-generator">

    <h1>@Model.AppTitle</h1>

    <br />

    <form method="post">
        <button type="submit" class="generate-button">
            Generate Random Book
        </button>
    </form>

    <br />

    @if (Model.RandomBook != null)
    {
        <div class="book-card">

            <h2>@Model.RandomBook.Title</h2>

            <p><strong>Author: </strong>@Model.RandomBook.Author</p>

            <p><strong>Genre: </strong>@Model.RandomBook.Genre</p>

        </div>
    }

</div>